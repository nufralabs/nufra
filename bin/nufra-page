#!/usr/bin/env python3
"""nufra-page: one read-only page on this machine with what waits on you, weekly usage and every run (M6).

Serves http://127.0.0.1:PORT only. Reads runs/*/handoff.md, runs/*/.pen.json, runs/quota-stops.md,
`nufra-usage --json` and, with --sessions, a Slack listener's sessions.json, progress.json and windows.json.
Writes nothing. No JavaScript, no CDN, no network beyond the loopback socket.

Usage:
  nufra-page [--runs DIR ...] [--port 7401]     serve; /?auto=30 reloads every 30 s (off by default, WCAG 2.2.1)
  nufra-page [--runs DIR ...] --once            print the page to stdout and exit
  --sessions DIR (or NUFRA_SESSIONS=DIR)        also list Slack sessions from DIR/sessions.json, DIR/progress.json
                                                and DIR/windows.json, keyed "channel:thread_ts". When windows.json
                                                exists, only sessions with an open window show (like the Slack Home
                                                tab); a new session shows on the next reload. Only those three files
                                                are read; nothing else in DIR (never a token file).
  NUFRA_SLACK_URL=https://NAME.slack.com         adds "Open thread" links to the Slack sessions
  NUFRA_PAGE_USAGE_JSON=FILE                    read usage from FILE instead of running nufra-usage (tests)

States (each one is colour + shape + word, so colour is never the only signal):
  waiting  ■  handoff.md has an open gate: a question waits for you
  working  ●  a lock (.pen.json) says another harness holds the pen
  paused   ⏸  the last quota stop of the run is at the phase handoff.md points to
  done     ✓  the next action is "none" or "done"
  ready    ○  safe to resume; nothing else is known
  unreadable ! handoff.md is missing a field (run `nufra-handoff check`)

Stdlib only.
"""
import argparse
import datetime as dt
import html
import http.server
import json
import os
import re
import subprocess
import sys
import threading
import time

HERE = os.path.dirname(os.path.abspath(__file__))
USAGE_TOOL = os.path.join(HERE, "nufra-usage")
HOST = "127.0.0.1"
USAGE_TTL = 300
FIELDS = ("phase", "branch", "sha", "last footprint", "next action", "open gate",
          "harness", "cli_version", "adapter", "written")
SECRET = re.compile(r"(sk-[A-Za-z0-9_-]{8,}|xox[abprs]-[A-Za-z0-9-]{8,}|gh[pousr]_[A-Za-z0-9]{16,}"
                    r"|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----)")
ORDER = {"waiting": 0, "blocked": 1, "unreadable": 1, "paused": 2, "working": 3, "ready": 4, "done": 5}
SHAPE = {"waiting": "■", "working": "●", "paused": "⏸", "done": "✓", "ready": "○", "unreadable": "!", "blocked": "▲"}
SESSION_DAYS = 7      # a session not done shows for 7 days after its last step
DONE_HOURS = 24       # a done session shows for 24 hours
SESSION_MAX = 30
SLACK_URL = re.compile(r"^https://[a-z0-9-]+\.(enterprise\.)?slack\.com$")
SLACK_ID = re.compile(r"^[A-Z0-9]+$")
SLACK_TS = re.compile(r"^\d+\.\d+$")
HARNESS_NAME = {"claude": "Claude", "codex": "Codex", "gemini": "Gemini", "commandcode": "Command Code"}

FAVICON = ('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="14" '
           'fill="#1F2328"/><path d="M10 42 L25 42 L32 52 L39 42 L54 42" stroke="#d0d7de" stroke-width="6" '
           'fill="none" stroke-linejoin="round" stroke-linecap="round"/><path d="M32 12 C39 21 40 29 32 36 '
           'C24 29 25 21 32 12 Z" fill="#C8862A"/></svg>')
FAVICON_FILE = os.path.join(HERE, "..", "core", "favicon.svg")


def clean(text, limit=160):
    """One safe display string: no secrets, no home path, bounded."""
    text = SECRET.sub("[hidden]", str(text or ""))
    text = text.replace(os.path.expanduser("~"), "~")
    return text if len(text) <= limit else text[:limit - 1] + "…"


def parse_handoff(path):
    out = {}
    try:
        with open(path, errors="replace") as fh:
            for line in fh:
                m = re.match(r"^- ([a-z_ ]+): (.*)$", line.rstrip("\n"))
                if m:
                    out[m.group(1)] = m.group(2).strip()
    except OSError:
        return None
    return out


def last_stops(runs_dir):
    """run name -> (phase, reason) of its last row in quota-stops.md."""
    stops = {}
    try:
        with open(os.path.join(runs_dir, "quota-stops.md"), errors="replace") as fh:
            for line in fh:
                cells = [c.strip() for c in line.strip().strip("|").split("|")]
                if len(cells) == 5 and cells[0][:4].isdigit():
                    stops[cells[1]] = (cells[2], cells[3])
    except OSError:
        pass
    return stops


def run_state(run_dir, stops):
    name = os.path.basename(run_dir)
    f = parse_handoff(os.path.join(run_dir, "handoff.md"))
    row = {"run": name, "phase": "", "next": "", "harness": "", "written": "", "note": ""}
    if f is None:
        return None
    row.update(phase=f.get("phase", ""), next=f.get("next action", ""), harness=f.get("harness", ""),
               written=f.get("written", ""))
    missing = [k for k in FIELDS if k not in f]
    lock = None
    try:
        with open(os.path.join(run_dir, ".pen.json")) as fh:
            lock = json.load(fh)
    except (OSError, ValueError):
        pass
    gate = f.get("open gate", "none")
    if missing:
        row.update(state="unreadable", note="missing: " + ", ".join(missing))
    elif gate != "none":
        row.update(state="waiting", note=f"gate {gate.split(' ')[0]}: your answer in the thread")
    elif lock:
        row.update(state="working", harness=lock.get("harness", row["harness"]),
                   note=f"phase {lock.get('phase', '')} since {lock.get('started', '')[11:16]} UTC")
    elif name in stops and stops[name][0] == row["phase"]:
        row.update(state="paused", note="stopped: " + stops[name][1])
    elif re.match(r"^(none|done)\b", row["next"], re.I):
        row.update(state="done")
    else:
        row.update(state="ready")
    return row


def collect_runs(dirs):
    rows = []
    for runs_dir in dirs:
        if not os.path.isdir(runs_dir):
            continue
        stops = last_stops(runs_dir)
        for name in sorted(os.listdir(runs_dir)):
            path = os.path.join(runs_dir, name)
            if os.path.isdir(path) and not name.startswith("."):
                row = run_state(path, stops)
                if row:
                    rows.append(row)
    rows.sort(key=lambda r: (ORDER[r["state"]], r["written"] and -dt.datetime.fromisoformat(
        r["written"].replace("Z", "+00:00")).timestamp() if _iso_ok(r["written"]) else 0))
    return rows


def _iso_ok(s):
    try:
        dt.datetime.fromisoformat(str(s).replace("Z", "+00:00"))
        return True
    except ValueError:
        return False


def _load_json(path):
    try:
        with open(path) as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def collect_sessions(sdir, now=None):
    """Slack sessions from DIR/sessions.json + DIR/progress.json, newest first. Never reads another file."""
    if not sdir:
        return []
    now = now or time.time()
    meta = _load_json(os.path.join(sdir, "sessions.json"))
    prog = _load_json(os.path.join(sdir, "progress.json"))
    windows = _load_json(os.path.join(sdir, "windows.json")) if os.path.exists(
        os.path.join(sdir, "windows.json")) else None
    rows = []
    for key in (windows if windows is not None else set(meta) | set(prog)):
        m, pr = meta.get(key) or {}, prog.get(key) or {}
        if not isinstance(m, dict) or not isinstance(pr, dict):
            continue
        pr = pr or {"text": "no status yet", "state": "working"}
        state = pr.get("state") if pr.get("state") in SHAPE else "working"
        try:
            at = float(pr.get("at") or 0)
        except (TypeError, ValueError):
            at = 0.0
        age = now - at
        if windows is None and age > (DONE_HOURS * 3600 if state == "done" else SESSION_DAYS * 86400):
            continue
        step = str(pr.get("step") or "")
        channel, _, thread = key.partition(":")
        q = str(pr.get("question_ts") or "") if state == "waiting" else ""
        rows.append({"channel": channel, "thread": thread, "question": q,
                     "workspace": m.get("workspace") or "?", "state": state, "step": step if re.fullmatch(
            r"\d+/\d+", step) else "", "text": pr.get("text", ""), "topic": m.get("topic", ""),
            "cli": m.get("cli", ""), "at": at, "age": age})
    rows.sort(key=lambda r: (ORDER[r["state"]], -r["at"]))
    return rows[:SESSION_MAX]


def ago(sec):
    sec = max(0, int(sec))
    if sec < 90:
        return "just now"
    if sec < 5400:
        return f"{sec // 60} min ago"
    if sec < 172800:
        return f"{sec // 3600} h ago"
    return f"{sec // 86400} days ago"


class Usage:
    """nufra-usage --json, run in the background at most every USAGE_TTL seconds."""

    def __init__(self):
        self.data, self.at, self.lock, self.busy = None, 0.0, threading.Lock(), False

    def load(self):
        fixture = os.environ.get("NUFRA_PAGE_USAGE_JSON")
        try:
            if fixture:
                with open(fixture) as fh:
                    return json.load(fh)
            r = subprocess.run([sys.executable, USAGE_TOOL, "--json"], capture_output=True, text=True,
                               timeout=60)
            return json.loads(r.stdout)
        except (OSError, ValueError, subprocess.SubprocessError):
            return {"error": True}

    def refresh(self):
        data = self.load()
        with self.lock:
            self.data, self.at, self.busy = data, time.time(), False

    def get(self, wait=False):
        with self.lock:
            stale = time.time() - self.at > USAGE_TTL
            start = stale and not self.busy
            if start:
                self.busy = True
        if start:
            if wait:
                self.refresh()
            else:
                threading.Thread(target=self.refresh, daemon=True).start()
        return self.data


def usage_cards(data):
    if data is None:
        return '<p class="muted">Reading usage…</p>'
    if data.get("error"):
        return '<p class="muted">Usage: nufra-usage did not answer.</p>'
    cards = []
    for h in data.get("harnesses", []):
        name = HARNESS_NAME.get(h.get("harness"), clean(h.get("harness"), 20))
        lim = h.get("limit") or {}
        pct = lim.get("used_percent")
        stale, said = False, ""
        if h.get("status") not in ("ok", None):
            value, bar, sub = "—", 0, "not on this machine"
        elif pct is None:
            value, bar, sub = "—", 0, "limit not on disk"
        else:
            value, bar, said = f"{pct:.0f}%", max(0, min(100, pct)), f"{pct:.0f}% used"
            asof = str(lim.get("timestamp") or "")[:10]
            reset = str(lim.get("resets_at") or "")[:10]
            sub = f"as of {asof}" + (f", resets {reset}" if reset else "")
            try:
                age = (dt.date.today() - dt.date.fromisoformat(asof)).days
            except ValueError:
                age = 0
            if age > 2:
                value, stale = f"{pct:.0f}%?", True
                sub = f"old: last seen {age} days ago" + (f", resets {reset}" if reset else "")
                said = f"{pct:.0f}% used, stale, last seen {age} days ago"
        said = said or sub
        tokens = h.get("tokens_window") or 0
        if tokens:
            sub += f" · {tokens / 1e6:,.0f}M tokens in 7 days"
        level = "hi" if isinstance(pct, (int, float)) and pct >= 80 else ""
        cards.append(
            f'<div class="card"><div class="cardtop"><span>{html.escape(name)}</span>'
            f'<b>{html.escape(value)}</b></div>'
            f'<div class="meter" role="img" aria-label="{html.escape(name)}: {html.escape(said)}">'
            f'<i class="{level}{" stale" if stale else ""}" style="width:{bar:.0f}%"></i></div>'
            f'<small>{html.escape(clean(sub, 80))}</small></div>')
    return '<div class="cards">' + "".join(cards) + "</div>" if cards else '<p class="muted">No harness found.</p>'


def chip(state):
    return f'<span class="chip {state}"><span aria-hidden="true">{SHAPE[state]}</span> {state}</span>'


def thread_link(base, channel, thread, msg=None):
    """Slack permalink, or "" when any part does not look like Slack's own format."""
    msg = msg or thread
    if not (base and SLACK_URL.match(base) and SLACK_ID.match(channel or "") and SLACK_TS.match(thread or "")
            and SLACK_TS.match(msg)):
        return ""
    return f"{base}/archives/{channel}/p{msg.replace('.', '')}?thread_ts={thread}&cid={channel}"


def links(r, base):
    out = []
    q = thread_link(base, r["channel"], r["thread"], r["question"]) if r["question"] else ""
    if q:
        out.append(f'<a href="{html.escape(q)}" rel="noreferrer">Open the question</a>')
    t = thread_link(base, r["channel"], r["thread"])
    if t:
        out.append(f'<a href="{html.escape(t)}" rel="noreferrer">Open thread <span aria-hidden="true">→</span>'
                   f'<span class="sr"> for {html.escape(clean(r["workspace"], 40))}</span></a>')
    return f'<div class="links">{" · ".join(out)}</div>' if out else ""


def session_list(sessions, e, base=None):
    if not sessions:
        return '<p class="muted">No open Slack session.</p>'
    items = []
    for r in sessions:
        step = ""
        if r["step"]:
            n, m = (int(x) for x in r["step"].split("/"))
            step = (f'<span class="rail" role="img" aria-label="step {n} of {m}">'
                    + "".join(f'<i class="{"on" if i < n else ""}"></i>' for i in range(min(m, 12)))
                    + f'</span> <small>{n}/{m}</small>')
        items.append(
            f'<li class="sess"><div class="shead"><b>{e(r["workspace"], 40)}</b> {chip(r["state"])} {step}'
            f'<small class="when">{e(HARNESS_NAME.get(r["cli"], r["cli"]), 20)} · {ago(r["age"])}</small></div>'
            f'<div>{e(r["text"])}</div><small class="topic">{e(r["topic"], 120)}</small>{links(r, base)}</li>')
    return f'<ul class="sessions" aria-label="Slack sessions">{"".join(items)}</ul>'


def render(rows, usage, now=None, auto=False, sessions=None, slack_url=None):
    now = now or dt.datetime.now().astimezone()
    sessions_on = sessions is not None
    sessions = sessions or []
    e = lambda s, n=160: html.escape(clean(s, n))
    waiting = [{"run": r["run"], "note": r["note"]} for r in rows if r["state"] == "waiting"] + [
        {"run": r["workspace"], "note": r["text"], "link": thread_link(slack_url, r["channel"], r["thread"],
                                                                      r["question"] or None)}
        for r in sessions if r["state"] == "waiting"]
    if waiting:
        items = "".join(f"<li><b>{e(r['run'], 60)}</b> · {e(r['note'])}" + (
            f' · <a href="{html.escape(r["link"])}" rel="noreferrer">Open</a>' if r.get("link") else "") + "</li>"
            for r in waiting)
        top = f'<section class="wait" aria-label="Waiting on you"><h2><span aria-hidden="true">■</span> Waiting on you ({len(waiting)})</h2>' \
              f'<ul>{items}</ul></section>'
    else:
        top = '<section class="calm" aria-label="Waiting on you"><h2><span aria-hidden="true">○</span> Nothing waits on you</h2></section>'
    if rows:
        body = "".join(
            f"<tr><td>{e(r['run'], 60)}</td><td>{chip(r['state'])}</td>"
            f"<td>{e(HARNESS_NAME.get(r['harness'], r['harness']), 20)}</td><td>{e(r['phase'], 60)}</td>"
            f"<td>{e(r['note'] or r['next'])}</td></tr>" for r in rows)
        table = ('<div class="scroll" tabindex="0" role="region" aria-label="Runs"><table><thead><tr><th scope="col">Run</th><th scope="col">State</th>'
                 '<th scope="col">Tool</th><th scope="col">Phase</th><th scope="col">Next</th></tr></thead>'
                 f'<tbody>{body}</tbody></table></div>')
    else:
        table = '<p class="muted">No runs with a handoff.md yet.</p>'
    return f"""<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">{'<meta http-equiv="refresh" content="30">' if auto else ''}
<title>nufra</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"><style>{CSS}</style></head>
<body><main><header><h1>nufra</h1><p class="muted">Read only · this machine · updated
<time datetime="{now.isoformat(timespec='seconds')}">{now.strftime('%H:%M')}</time> ·
{'<a href="/">Stop auto-reload</a>' if auto else '<a href="/">Reload</a> · <a href="/?auto=30">Auto-reload every 30 s</a>'}</p></header>
{top}{"<h2>Slack sessions</h2>" + session_list(sessions, e, slack_url) if sessions_on else ""}<h2>Usage this week</h2>{usage_cards(usage)}<h2>Runs</h2>{table}
<footer class="muted">You answer in Slack or the terminal. This page never changes anything.</footer>
</main></body></html>"""


