def favicon():
    try:
        with open(FAVICON_FILE) as fh:
            return fh.read()
    except OSError:
        return FAVICON


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "nufra-page"
    sys_version = ""

    def log_message(self, *args):
        pass  # nothing logged, nothing written

    def send(self, code, body, ctype="text/html; charset=utf-8"):
        data = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Content-Security-Policy", "default-src 'none'; style-src 'unsafe-inline'; img-src 'self'")
        self.send_header("Referrer-Policy", "no-referrer")
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(data)

    def do_GET(self):
        host = (self.headers.get("Host") or "").rsplit(":", 1)[0]
        if host not in ("127.0.0.1", "localhost"):
            return self.send(421, "wrong host\n", "text/plain")  # blocks DNS rebinding
        path, _, query = self.path.partition("?")
        if path == "/":
            sessions = collect_sessions(self.server.sessions) if self.server.sessions else None
            return self.send(200, render(collect_runs(self.server.runs), self.server.usage.get(),
                                         auto=query == "auto=30", sessions=sessions,
                                         slack_url=self.server.slack_url))
        if path == "/favicon.svg":
            return self.send(200, favicon(), "image/svg+xml")
        return self.send(404, "not found\n", "text/plain")

    do_HEAD = do_GET

    def refuse(self):
        self.send(405, "read only\n", "text/plain")

    do_POST = do_PUT = do_DELETE = do_PATCH = refuse


def main(argv=None):
    p = argparse.ArgumentParser(prog="nufra-page")
    p.add_argument("--runs", action="append", help="a runs/ folder (default ./runs); repeat for more")
    p.add_argument("--port", type=int, default=7401)
    p.add_argument("--once", action="store_true", help="print the page and exit")
    p.add_argument("--sessions", default=os.environ.get("NUFRA_SESSIONS"),
                   help="folder with a Slack listener's sessions.json and progress.json")
    a = p.parse_args(argv)
    runs = [os.path.abspath(os.path.expanduser(d)) for d in (a.runs or ["runs"])]
    sdir = os.path.abspath(os.path.expanduser(a.sessions)) if a.sessions else None
    slack_url = (os.environ.get("NUFRA_SLACK_URL") or "").rstrip("/") or None
    usage = Usage()
    if a.once:
        sys.stdout.write(render(collect_runs(runs), usage.get(wait=True),
                                sessions=collect_sessions(sdir) if sdir else None, slack_url=slack_url))
        return 0
    srv = http.server.ThreadingHTTPServer((HOST, a.port), Handler)
    srv.runs, srv.usage, srv.sessions, srv.slack_url = runs, usage, sdir, slack_url
    usage.get()
    print(f"nufra page: http://{HOST}:{srv.server_address[1]}  (read only; Ctrl-C to stop)", flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
