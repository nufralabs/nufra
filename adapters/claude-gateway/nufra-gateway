#!/usr/bin/env python3
"""nufra-gateway: run Claude Code against an Anthropic-format gateway (for example a prepaid router), so the same
workflow, skills and hooks keep working while only the model and the bill change.

The gateway session is a full Claude Code session, so it is a coordinator like any Claude session: it follows the
same gate rules (only the user closes a gate). It is NOT a resume of the old chat: it starts fresh from handoff.md.

A profile is a local JSON file (never in this repo), for example ~/.config/nufra/gateways/NAME.json:
    {"name": "router", "base_url": "https://gateway.example", "key_file": "~/.router-secret", "model": "model-id"}
Optional: "default_mode": one of default, acceptEdits, plan, dontAsk (default acceptEdits). The window takes
this mode and allows Bash, Read, Edit and Write, so no tool call waits on a safety check. Those keys go in
the window's own settings file, which claude merges over the user and project files: the user's global
settings keep every key not named here, so other sessions are untouched.

Commands:
  nufra-gateway check  --profile P                 validate the profile; print the settings with the key hidden
  nufra-gateway exec   --profile P -- [claude args] run claude with the profile (used by launchers)
  nufra-gateway start  --profile P --run RUN_DIR --repo REPO [--window] [--intro TEXT] [--dry-run]
                                                   guards, then a fresh session from handoff.md; holds the pen
  nufra-gateway release --run RUN_DIR              give the pen back (remove RUN_DIR/.pen.json written by start)

Guards (exit 4 = refused):
  G1 MCP:   claude starts with --strict-mcp-config and an empty MCP file, so no MCP server loads
  G2 key:   the key file exists, is not empty and is readable by its owner only (mode 600); https base URL only
  G3 model: one model for every slot (main, haiku/sonnet/opus/fable aliases, subagents, auto mode), so no call
            goes to a model the user did not pick. One named exception: a profile may set "subagent_model", which
            moves subagents only, and only to the model the user wrote there.
  G4 one:   no other harness holds the pen (RUN_DIR/.pen.json)
  G5 resume: `nufra-handoff check` says OK before start
The key reaches Claude Code through an apiKeyHelper that reads the key file, so it is not in the environment and
Claude Code does not ask about it. It is never printed, logged or written to another file.
Stdlib only.
"""
import argparse
import json
import os
import shlex
import stat
import subprocess
import sys
import tempfile
import time
import uuid

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.normpath(os.path.join(HERE, "..", ".."))
HANDOFF = os.path.join(ROOT, "bin", "nufra-handoff")
CONTINUE = os.path.join(ROOT, "bin", "nufra-continue")
MODEL_VARS = ("ANTHROPIC_MODEL", "ANTHROPIC_DEFAULT_HAIKU_MODEL", "ANTHROPIC_DEFAULT_SONNET_MODEL",
              "ANTHROPIC_DEFAULT_OPUS_MODEL", "ANTHROPIC_DEFAULT_FABLE_MODEL", "CLAUDE_CODE_SUBAGENT_MODEL",
              "CLAUDE_CODE_AUTO_MODE_MODEL")
CLEAR_VARS = ("ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_SMALL_FAST_MODEL", "CLAUDE_CODE_USE_BEDROCK",
              "CLAUDE_CODE_USE_VERTEX", "CLAUDE_CODE_USE_FOUNDRY")
# Permission modes a gateway window may take. The default is acceptEdits, never auto: in auto mode a second
# model judges every tool call, which is the extra wait and the extra tokens this adapter exists to avoid.
# A profile may still opt into auto, but it has to say so.
MODES = ("default", "acceptEdits", "plan", "auto", "dontAsk")
# Delegation DNA. A profile may name one mode, and every window it opens carries that rule in its launch prompt.
# "always": batch independent calls into one message, and send bulk reading to a subagent that reports facts while
# the main window keeps the judgement. The subagent model is the profile's subagent_model, so on a router with a
# free small model the reading costs nothing on the main bill.
DELEGATION = ("always",)
DELEGATION_TEXT = {
    "always": (
        "Delegation (this profile's default, always on for every window it opens):\n"
        "1. This window is the orchestrator, not the worker. It takes the order, briefs a subagent, judges the\n"
        "   report, then briefs the next one. It writes no file, reads no file and runs no command itself. Every\n"
        "   read, grep, git query and test run goes to a subagent: subagents here run on {sub}.\n"
        "2. Batch. A chain of checks is ONE brief, never a call each. Every independent call a brief can make\n"
        "   goes in the same round.\n"
        "3. Count the calls. Each call re-reads the whole conversation, so the bill comes from the count, not the\n"
        "   size. Keep this window to 6 calls or fewer in a turn. A one-line lookup is still the subagent's job.\n"
        "4. Spend only on the named work. A problem the user did not ask about waits for the user. Do not fix it,\n"
        "   do not draw it, do not ask about it.\n"
        "5. Decide locally. The subagent reports facts with line numbers. This window makes every judgement, every\n"
        "   gate and every Slack/commit message. Never let a subagent decide.\n"
        "6. Pipe long success output through `tail -n 40`. Never cut error output."
    ),
}


def refuse(msg):
    print(f"REFUSED: {msg}")
    sys.exit(4)


def load_profile(path):
    path = os.path.expanduser(path)
    try:
        with open(path) as fh:
            p = json.load(fh)
    except (OSError, ValueError) as exc:
        refuse(f"profile {path}: {exc.__class__.__name__}")
    for k in ("name", "base_url", "key_file", "model"):
        if not str(p.get(k) or "").strip():
            refuse(f"profile {path}: '{k}' is missing")
    if not p["base_url"].startswith("https://"):
        refuse("G2 key: base_url must start with https://")
    if any(k in p for k in ("key", "api_key", "token")):
        refuse("profile must point to a key file (key_file), never hold the key itself")
    mode = p.get("default_mode", "acceptEdits")
    if mode not in MODES:
        refuse("default_mode must be one of: " + ", ".join(MODES))
    sub = p.get("subagent_model")
    if sub is not None and not isinstance(sub, str):
        refuse("subagent_model must be one model name, as a string")
    deliver = p.get("delegation")
    if deliver is not None and deliver not in DELEGATION:
        refuse("delegation must be one of: " + ", ".join(DELEGATION))
    return p


def delegation_note(p):
    """The rule text a profile adds to its own launch prompt. Empty when the profile sets no delegation mode.
    This lives in the profile, not the listener, so a window started by hand gets the same rule as one started
    by a hand-over."""
    mode = p.get("delegation")
    if not mode:
        return ""
    return DELEGATION_TEXT[mode].format(sub=p.get("subagent_model") or p["model"], model=p["model"])


def read_key(p):
    kf = os.path.expanduser(p["key_file"])
    try:
        st = os.stat(kf)
    except OSError:
        refuse(f"G2 key: key file {p['key_file']} not found")
    if st.st_mode & (stat.S_IRWXG | stat.S_IRWXO):
        refuse(f"G2 key: {p['key_file']} is readable by other users; run chmod 600 {p['key_file']}")
    key = open(kf).read().strip()
    if not key or "\n" in key:
        refuse(f"G2 key: {p['key_file']} must hold one key on one line")
    return key


def child_env(p, key):
    env = dict(os.environ)
    for v in CLEAR_VARS:
        env.pop(v, None)
    env.pop("ANTHROPIC_API_KEY", None)  # the key comes from apiKeyHelper, so Claude Code does not ask about it
    env["ANTHROPIC_BASE_URL"] = p["base_url"].rstrip("/")
    for v in MODEL_VARS:
        env[v] = p["model"]
    # G3, one named exception: a profile may name a second model for subagents only (e.g. a free one on the same
    # router). Every other slot stays on p["model"], so no call can go to a model the user did not pick. The probe
    # on 2026-11-26 showed Claude Code really launches the subagent on this model: a bogus name fails with
    # model_not_found, a real free name answers. Absent the key, behaviour is exactly as before.
    env["CLAUDE_CODE_SUBAGENT_MODEL"] = (p.get("subagent_model") or p["model"]).strip()
    env["CLAUDE_CODE_SUBAGENT_MODEL_FORCE"] = "1"
    env["NUFRA_GATEWAY"] = p["name"]
    return env


def empty_mcp():
    fd, path = tempfile.mkstemp(prefix="nufra-gateway-mcp-", suffix=".json")
    with os.fdopen(fd, "w") as fh:
        fh.write('{"mcpServers":{}}\n')
    return path


def helper_settings(p):
    """A settings file whose apiKeyHelper prints the key file. The key itself is never written anywhere.

    It also sets this window's permissions, so a gateway window does not pay for a safety check on every
    tool call. These keys apply to this window only: claude merges a --settings file over the user and
    project files, so the user's own settings keep every key not named here.
    """
    fd, path = tempfile.mkstemp(prefix="nufra-gateway-settings-", suffix=".json")
    with os.fdopen(fd, "w") as fh:
        json.dump({
            "apiKeyHelper": "/bin/cat " + shlex.quote(os.path.expanduser(p["key_file"])),
            "permissions": {
                "allow": ["Bash", "Read", "Edit", "Write"],
                "defaultMode": p.get("default_mode", "acceptEdits"),
            },
        }, fh)
    return path


def claude_argv(extra, p):
    return ["claude", "--strict-mcp-config", "--mcp-config", empty_mcp(), "--settings", helper_settings(p), *extra]


def cmd_check(a):
    p = load_profile(a.profile)
    key = read_key(p)
    print(f"profile {p['name']}: OK")
    print(f"  ANTHROPIC_BASE_URL={p['base_url'].rstrip('/')}")
    print(f"  apiKeyHelper=/bin/cat {p['key_file']}   (key: {len(key)} chars, never in the environment)")
    for v in MODEL_VARS:
        if v == "CLAUDE_CODE_SUBAGENT_MODEL" and p.get("subagent_model"):
            continue  # printed once, with the value it really gets, on the line below
        print(f"  {v}={p['model']}")
    if p.get("subagent_model"):
        print(f"  CLAUDE_CODE_SUBAGENT_MODEL={p['subagent_model']}   (subagents only; every other slot stays on {p['model']})")
    print("  CLAUDE_CODE_SUBAGENT_MODEL_FORCE=1")
    if p.get("delegation"):
        print(f"  delegation={p['delegation']}   (batch + delegate rule carried in every launch prompt)")
    print("  claude --strict-mcp-config --mcp-config <empty>   (no MCP servers)")
    return 0


def cmd_exec(a):
    p = load_profile(a.profile)
    key = read_key(p)
    argv = claude_argv([x for x in a.claude_args if x != "--"], p)
    os.execvpe(argv[0], argv, child_env(p, key))


def handoff_fields(run_dir):
    out = {}
    try:
        for line in open(os.path.join(run_dir, "handoff.md")).read().splitlines():
            if line.startswith("- ") and ": " in line:
                k, v = line[2:].split(": ", 1)
                out[k.strip()] = v.strip()
    except OSError:
        pass
    return out


def open_window(command):
    script = f'tell application "Terminal"\nset t to do script {json.dumps(command)}\ndelay 1\n' \
             'return id of (first window whose selected tab is t)\nend tell'
    r = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if r.returncode != 0:
        refuse(f"could not open a Terminal window: {r.stderr.strip()[:200]}")
    return int(r.stdout.strip())


def launch_prompt(intro, continue_text, p):
    """The text the new window reads: the caller's intro, then the profile's own rules, then the resume point.
    Separate from cmd_start so the assembly can be tested without launching a window."""
    note = delegation_note(p)
    return (intro + "\n\n" if intro else "") + (note + "\n\n" if note else "") + continue_text.strip()


def cmd_start(a):
    p = load_profile(a.profile)
    read_key(p)  # G2 before anything is written
    run_dir = os.path.abspath(a.run)
    pen = os.path.join(run_dir, ".pen.json")
    if os.path.exists(pen):
        try:
            holder = json.load(open(pen)).get("harness", "?")
        except ValueError:
            holder = "?"
        refuse(f"G4 one agent: {holder} already holds the pen ({pen})")
    r = subprocess.run([sys.executable, HANDOFF, "check", run_dir, "--repo", a.repo], capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.startswith("OK"):
        refuse(f"G5 resume: nufra-handoff check: {(r.stdout + r.stderr).strip()[:300]}")
    c = subprocess.run([sys.executable, CONTINUE, "prompt", run_dir, "--repo", a.repo], capture_output=True, text=True)
    if c.returncode != 0:
        refuse(f"nufra-continue: {(c.stdout + c.stderr).strip()[:300]}")
    prompt = launch_prompt(a.intro, c.stdout, p)
    session_id = str(uuid.uuid4())
    me = os.path.abspath(__file__)
    # The prompt goes in a file: a long multi-line prompt typed into a terminal can break the shell line.
    prompt_file = os.path.join(run_dir, ".nufra-gateway-prompt.md")
    command = (f"cd {shlex.quote(os.path.abspath(a.workdir or a.repo))} && {shlex.quote(sys.executable)} "
               f"{shlex.quote(me)} exec --profile {shlex.quote(a.profile)} -- --session-id {session_id} "
               f"\"$(cat {shlex.quote(prompt_file)})\"")
    if a.dry_run:
        print(json.dumps({"dry_run": True, "session_id": session_id, "command": command[:400] + "…"}, indent=2))
        return 0
    with open(prompt_file, "w") as fh:
        fh.write(prompt + "\n")
    fields = handoff_fields(run_dir)
    with open(pen, "w") as fh:
        json.dump({"harness": f"claude@{p['name']}", "model": p["model"], "phase": fields.get("phase", ""),
                   "session_id": session_id, "started": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}, fh,
                  indent=2)
    if a.window:
        wid = open_window(command)
        print(json.dumps({"ok": True, "window_id": wid, "session_id": session_id,
                          "launch": f"{shlex.quote(sys.executable)} {shlex.quote(me)} exec --profile "
                                    f"{shlex.quote(a.profile)} --"}))
        return 0
    os.execvp("/bin/sh", ["/bin/sh", "-c", command])


def cmd_release(a):
    pen = os.path.join(os.path.abspath(a.run), ".pen.json")
    if not os.path.exists(pen):
        print("no pen file: nothing to release")
        return 0
    holder = json.load(open(pen)).get("harness", "")
    if not holder.startswith("claude@"):
        refuse(f"the pen is held by {holder}, not by a gateway session")
    os.remove(pen)
    print(f"released: {holder} no longer holds {a.run}")
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="nufra-gateway")
    sub = ap.add_subparsers(dest="cmd", required=True)
    c = sub.add_parser("check")
    c.add_argument("--profile", required=True)
    e = sub.add_parser("exec")
    e.add_argument("--profile", required=True)
    e.add_argument("claude_args", nargs=argparse.REMAINDER)
    s = sub.add_parser("start")
    s.add_argument("--profile", required=True)
    s.add_argument("--run", required=True)
    s.add_argument("--repo", required=True)
    s.add_argument("--workdir", help="folder to start claude in (default: --repo)")
    s.add_argument("--intro", default="")
    s.add_argument("--window", action="store_true", help="open a new Terminal window (macOS)")
    s.add_argument("--dry-run", action="store_true")
    r = sub.add_parser("release")
    r.add_argument("--run", required=True)
    a = ap.parse_args(argv)
    return {"check": cmd_check, "exec": cmd_exec, "start": cmd_start, "release": cmd_release}[a.cmd](a)


if __name__ == "__main__":
    sys.exit(main())
